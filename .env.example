# このファイルを .env にコピーし、実APIを使う場合だけ値を設定してください。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_MODE=auto
# Claude API（解析へのLLM活用の検証用）。キーを書けば使える。確認: python scripts/check_claude_api.py
ANALYSIS_ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# record=同じ問い合わせは保存済み応答を再利用 / replay=保存済みのみ（通信なし） / live=毎回呼ぶ
CLAUDE_CACHE_MODE=record
