#1076 = ORIENTED_EDGE('',*,*,#1055,.F.);
#1077 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) 
GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#1081)) 
